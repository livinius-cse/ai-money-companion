            },
            "type": "array",
            "title": "Translation Tools Used"
          },
          "translation_editing_extent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Translation Editing Extent"
          },
          "kdp_submission_declaration": {
            "type": "string",
            "title": "Kdp Submission Declaration"
          },
