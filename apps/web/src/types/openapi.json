      "AIExecutionMetadata": {
        "properties": {
          "requested_provider": {
            "type": "string",
            "enum": [
              "mock",
              "gemini"
            ],
            "title": "Requested Provider"
          },
          "actual_provider": {
            "type": "string",
            "enum": [
              "mock",
              "gemini"
            ],
            "title": "Actual Provider"
          },
          "is_mock_generated": {
            "type": "boolean",
            "title": "Is Mock Generated"
          },
          "model_name": {
            "type": "string",
            "title": "Model Name"
          },
          "execution_duration_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Execution Duration Ms",
            "default": 0
          },
          "is_fallback": {
            "type": "boolean",
            "title": "Is Fallback",
            "default": false
          },
          "fallback_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallback Reason"
          }
        },
        "type": "object",
        "required": [
          "requested_provider",
          "actual_provider",
          "is_mock_generated",
          "model_name"
        ],
        "title": "AIExecutionMetadata"
      },
