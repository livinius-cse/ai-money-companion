                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/metadata": {
      "post": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Generate Metadata",
        "description": "Generate 1 to 7 KDP search keywords, categories, and conservative HTML description.\nProtected by authentication and CSRF validation.",
        "operationId": "generate_metadata_api_v1_ai_metadata_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
