    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check Health",
        "description": "Health check endpoint for local readiness probe.",
        "operationId": "check_health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "Authentication"
        ],
        "summary": "Get Csrf Token",
        "description": "Issue a signed CSRF token bound to the current session (or anonymous).\nSets the readable csrf_token cookie for the client.",
        "operationId": "get_csrf_token_api_v1_auth_csrf_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CSRFResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/setup": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Setup Initial Admin",
        "description": "Bootstrap the initial root administrator account on first run.\nUses database-level serialization (BEGIN IMMEDIATE on SQLite) and an atomic\nuniqueness lock record (SystemState) to prevent race conditions.",
        "operationId": "setup_initial_admin_api_v1_auth_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
