            "type": "boolean",
            "title": "Authenticated"
          },
          "user": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "authenticated"
        ],
        "title": "AuthStatusResponse"
      },
      "BookPlanRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Topic"
          },
          "target_audience": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Target Audience"
          },
          "book_type": {
            "type": "string",
            "enum": [
              "NON_FICTION",
              "LOW_CONTENT",
              "GUIDE"
            ],
            "title": "Book Type",
            "default": "NON_FICTION"
          },
          "print_format": {
            "type": "string",
            "enum": [
              "paperback",
              "hardcover"
            ],
            "title": "Print Format",
            "default": "paperback"
          },
          "marketplace": {
            "type": "string",
            "maxLength": 30,
            "title": "Marketplace",
            "default": "amazon_com"
          },
          "target_trim_size": {
            "type": "string",
            "maxLength": 20,
            "title": "Target Trim Size",
            "default": "6x9"
          },
          "paper_type": {
            "type": "string",
            "maxLength": 30,
            "title": "Paper Type",
            "default": "white_bw"
          },
          "target_pages": {
            "type": "integer",
            "maximum": 3000.0,
            "minimum": 1.0,
            "title": "Target Pages",
            "description": "Estimated target pages (validated dynamically against selected KDP spec)",
            "default": 120
          }
        },
        "type": "object",
        "required": [
          "topic",
          "target_audience"
        ],
        "title": "BookPlanRequest"
      },
      "BookPlanResponse": {
        "properties": {
          "title_options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Title Options"
          },
          "subtitle_options": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Subtitle Options"
          },
          "target_reader_avatar": {
            "type": "string",
            "title": "Target Reader Avatar"
          },
          "front_matter_pages": {
            "type": "integer",
            "minimum": 2.0,
            "title": "Front Matter Pages",
            "default": 4
          },
          "chapters": {
            "items": {
              "$ref": "#/components/schemas/ChapterPlanItem"
