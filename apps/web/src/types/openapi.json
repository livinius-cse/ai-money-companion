            ],
            "title": "Kdp Manufacturing Notice"
          },
          "specification_matched": {
            "type": "boolean",
            "title": "Specification Matched",
            "default": true
          },
          "spec_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
