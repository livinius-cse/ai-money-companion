        }
      }
    },
    "/api/v1/ai/plan": {
      "post": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Generate Book Plan",
        "description": "Generate a structured publishing plan, chapter outlines, and page budget.\nProtected by authentication and CSRF validation.",
        "operationId": "generate_book_plan_api_v1_ai_plan_post",
