                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/disclosure/confirm": {
      "post": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Confirm Ai Disclosure",
        "description": "Persist server-verified author attestation.\nDerived fields (user_id, timestamp, author_reviewed) are stamped exclusively by the backend.",
        "operationId": "confirm_ai_disclosure_api_v1_ai_disclosure_confirm_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIDisclosureConfirmRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIDisclosureResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/disclosure/latest": {
      "get": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Get Latest Disclosure",
        "description": "Retrieve the most recent confirmed attestation for the authenticated user.\nAuthentication required; no CSRF required for safe GET method.",
        "operationId": "get_latest_disclosure_api_v1_ai_disclosure_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
