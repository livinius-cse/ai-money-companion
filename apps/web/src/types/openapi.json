          "total_calculated_pages": {
            "type": "integer",
            "title": "Total Calculated Pages"
          },
          "is_odd_page_count": {
            "type": "boolean",
            "title": "Is Odd Page Count"
          },
          "kdp_manufacturing_notice": {
            "anyOf": [
