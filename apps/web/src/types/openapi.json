          "translation_tools_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Translation Tools Used"
          },
          "translation_editing_extent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none_or_minimal",
                  "some_editing",
                  "extensive_editing"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Translation Editing Extent"
          },
          "author_confirmed": {
            "type": "boolean",
            "title": "Author Confirmed",
            "description": "Must explicitly be True."
