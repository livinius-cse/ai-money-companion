                "schema": {
                  "$ref": "#/components/schemas/AIDisclosureResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/validate/print-specs": {
      "post": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Validate Print Specs",
        "description": "Validate print specifications against the verified KDP specification matrix.\nProtected by authentication and CSRF.",
        "operationId": "validate_print_specs_api_v1_ai_validate_print_specs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrintSpecsValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/validate/metadata": {
      "post": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Validate Metadata",
        "description": "Validate title/subtitle length, keyword count, and HTML description tags.\nProtected by authentication and CSRF.",
        "operationId": "validate_metadata_api_v1_ai_validate_metadata_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetadataValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResultResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ai/specs": {
      "get": {
        "tags": [
          "AI Publishing Engine"
        ],
        "summary": "Get Kdp Specifications",
        "description": "Public catalog endpoint returning active versioned KDP specification metadata.\nPublic and unauthenticated; exposes no user data or secrets.",
        "operationId": "get_kdp_specifications_api_v1_ai_specs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Get Kdp Specifications Api V1 Ai Specs Get"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
