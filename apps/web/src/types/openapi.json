          "image_tools_used": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Image Tools Used"
          },
          "image_editing_extent": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "none_or_minimal",
