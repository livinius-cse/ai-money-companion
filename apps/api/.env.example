# AI Money Companion — Environment Configuration Template
# Copy this file to .env and configure strong random secrets before running the application:
#
# Generate secure 32+ character keys in your terminal using:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

PROJECT_NAME="AI Money Companion API"
API_V1_STR="/api/v1"

# Security Configuration
# Required: At least 32 characters each. Must be distinct cryptographic keys.
# Do not use placeholder values or commit secrets to version control.
SECRET_KEY="GENERATE_AND_PASTE_A_32_CHAR_SECRET_KEY_HERE"
CSRF_SECRET_KEY="GENERATE_AND_PASTE_A_32_CHAR_CSRF_KEY_HERE"

# JWT & Cookie Security
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SECURE_COOKIE=false
COOKIE_SAMESITE="strict"

# Rate Limiting (positive integer)
RATE_LIMIT_LOGIN_PER_MINUTE=5

# CORS & CSRF Allowed Origins
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database & Storage
DATABASE_URL="sqlite:///./ai_money_companion.db"
STORAGE_DIR="./storage"

# AI Provider (mock is offline and ₹0 cost)
AI_PROVIDER="mock"
GEMINI_API_KEY=""
